SECRETS_MASTER_KEY=base64:c2ZtaW5pLWRldi1tYXN0ZXIta2V5LTMyYnl0ZXMhISE=
LLM_PROVIDER=stub
LLM_API_KEY=
LLM_MODEL=claude-3-5-sonnet-20241022

