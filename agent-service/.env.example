# agent-service 配置（复制为 .env，.env 已 gitignore，不提交）
PORT=9100
AUTH_BEARER_TOKEN=dev-single-workspace-token
BACKEND_ORIGIN=http://localhost:8000

# LLM provider（DeepSeek，OpenAI 兼容协议）
# 模型名/地址/Key 全部可配；Key 仅注入内存，绝不提交
LLM_PROVIDER_INNER=deepseek
LLM_MODEL=deepseek-v4-pro
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
