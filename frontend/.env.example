# 前端环境变量样例。复制为 .env.local。
# 后端来源（next.config.mjs 的 /api/v1 rewrites 代理到此处）
BACKEND_ORIGIN=http://localhost:8001
NEXT_PUBLIC_API_BASE=/api/v1
NEXT_PUBLIC_TOKEN=dev-single-workspace-token
# SSE 直连后端：Next.js dev 代理会缓冲 text/event-stream 导致流式不实时，
# 故 EventSource 直连后端绕过代理。生产同源部署时可改为 /api/v1。
NEXT_PUBLIC_SSE_BASE=http://localhost:8001/api/v1
