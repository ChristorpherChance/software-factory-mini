# ============================================================
#  软件工厂 Mini · 端口单一配置源（Single Source of Truth）
# ------------------------------------------------------------
#  改端口只改这里：start.sh / start.bat / stop.sh /
#  cleanup_ports.ps1 / run_backend.sh / run_frontend.sh 全部读取本文件。
#  docker / 云端见 docker-compose.yml 顶部说明（用同名变量，可在 .env 覆盖）。
#  格式要求：KEY=VALUE，等号两侧无空格，值不加引号（需被 bash/bat/ps1 同时解析）。
# ============================================================
BACKEND_PORT=8001
FRONTEND_PORT=3001
AGENT_PORT=9100
